# Backend environment template. Copy to backend/.env for local backend runs.
# Do not commit real credentials, account IDs, or secret values.

# Shared Alpaca credentials.
# Regime uses these for Alpaca Paper account verification, order transport, and market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2

# Paper endpoint safety.
# Keep this on the Alpaca Paper trading endpoint. A live Alpaca URL blocks automated paper entries.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2

# Meta-Strategy automatic paper runtime.
# Safe defaults keep all automatic entries disabled. Paper activation must be explicit and audited.
API_EMBEDDED_ALGORITHM_RUNTIMES_ENABLED=false
API_EMBEDDED_META_STRATEGY_RUNTIME_ENABLED=false
API_EMBEDDED_VOTING_ENSEMBLE_RUNTIME_ENABLED=false
API_EMBEDDED_WEIGHTED_VOTING_RUNTIME_ENABLED=false
API_EMBEDDED_REGIME_RUNTIME_ENABLED=false
API_EMBEDDED_WCA_FINALIZED_BAR_ENABLED=false
META_STRATEGY_RUNTIME_ENABLED=false
META_STRATEGY_RUNTIME_MODE=SHADOW
META_STRATEGY_LIVE_TRADING_ENABLED=false
META_STRATEGY_PAPER_NEW_ENTRIES_ENABLED=false
META_STRATEGY_SYMBOLS=SPY
META_STRATEGY_MARKET_DATA_FEED=iex

# Meta-Strategy paper broker/order transport.
# Local paper account and risk are derived from Meta-Strategy trading settings
# plus its own inventory/risk ledger. Set LOCAL_PAPER only when a local PAPER-only
# broker service is running and reachable for order transport. Use LOCAL_LEDGER
# to route paper orders through the Meta-Strategy local gateway ledger.
META_STRATEGY_PAPER_BROKER=ALPACA
META_STRATEGY_LOCAL_LEDGER_MARKET_OPEN=false
META_STRATEGY_LOCAL_LEDGER_IMMEDIATE_FILLS=false
META_STRATEGY_LOCAL_PAPER_BASE_URL=
META_STRATEGY_LOCAL_PAPER_TOKEN=
META_STRATEGY_LOCAL_PAPER_ACCOUNT_PATH=/account
META_STRATEGY_LOCAL_PAPER_CLOCK_PATH=/clock
META_STRATEGY_LOCAL_PAPER_ORDERS_PATH=/orders
META_STRATEGY_LOCAL_PAPER_POSITIONS_PATH=/positions
META_STRATEGY_LOCAL_RISK_SNAPSHOT_PATH=/risk/snapshot
META_STRATEGY_LOCAL_RISK_APPROVAL_PATH=/risk/approve

# Meta-Strategy background-worker intervals and leases.
META_STRATEGY_WORKER_POLL_SECONDS=1
META_STRATEGY_RECONCILIATION_POLL_SECONDS=15
META_STRATEGY_STALE_ORDER_POLL_SECONDS=30
META_STRATEGY_INVENTORY_RECONCILIATION_POLL_SECONDS=60
META_STRATEGY_POSITION_MANAGEMENT_POLL_SECONDS=15
META_STRATEGY_HEARTBEAT_INTERVAL_SECONDS=5
META_STRATEGY_MAINTENANCE_INTERVAL_SECONDS=15
META_STRATEGY_CANDLE_POLL_SECONDS=5
META_STRATEGY_WORKER_LEASE_SECONDS=60

# Meta-Strategy freshness and operational block thresholds.
META_STRATEGY_QUOTE_FRESHNESS_LIMIT_SECONDS=60
META_STRATEGY_CANDLE_FRESHNESS_LIMIT_SECONDS=180
META_STRATEGY_ORDER_INTENT_MAX_AGE_SECONDS=300
META_STRATEGY_DECISION_MAX_AGE_SECONDS=300
META_STRATEGY_GLOBAL_RISK_FRESHNESS_LIMIT_SECONDS=30
META_STRATEGY_MARKET_CLOCK_FRESHNESS_LIMIT_SECONDS=30
META_STRATEGY_QUEUE_LAG_THRESHOLD_SECONDS=75
META_STRATEGY_DEAD_LETTER_THRESHOLD=0

# Existing WCA paper settings.
WCA_ALPACA_PAPER_API_KEY_ID=
WCA_ALPACA_PAPER_API_SECRET_KEY=
WCA_ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
WCA_ALPACA_PAPER_ACCOUNT_ID=
WCA_AUTOMATIC_PAPER_ENABLED=false

# Regime paper runtime identity.
REGIME_PAPER_SYMBOL=SPY
REGIME_PAPER_ALGORITHM_INSTANCE_ID=regime-paper-default
REGIME_ALPACA_PAPER_ACCOUNT_ID=
# Optional compatibility aliases. Leave blank unless the deployment uses one of these names.
REGIME_PAPER_ACCOUNT_ID=
ALPACA_PAPER_ACCOUNT_ID=

# Regime feature and rollout defaults.
# Paper ON/OFF is an audited backend command, not an env toggle. These defaults do not enable live trading.
REGIME_V2_ENABLED=true
REGIME_DYNAMIC_PROFILE_ENABLED=true
REGIME_ML_MODE=shadow
REGIME_GLOBAL_RISK_MANAGER_ENABLED=true
REGIME_SHORT_ENTRIES_ENABLED=false
REGIME_PAPER_SUBMISSION_ENABLED=false
REGIME_AUTOMATIC_ORDER_SUBMISSION_ENABLED=false

# Regime runtime intervals.
REGIME_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=5
REGIME_RUNTIME_HEALTH_INTERVAL_SECONDS=5
REGIME_RUNTIME_MAINTENANCE_INTERVAL_SECONDS=30
REGIME_RUNTIME_EXECUTION_POLL_INTERVAL_SECONDS=1
REGIME_RUNTIME_RECONCILIATION_POLL_INTERVAL_SECONDS=3
REGIME_RUNTIME_POSITION_MANAGEMENT_INTERVAL_SECONDS=5
REGIME_RUNTIME_PUBLISHER_POLL_INTERVAL_SECONDS=1
REGIME_RUNTIME_CLOSED_MARKET_PUBLISHER_POLL_INTERVAL_SECONDS=300
REGIME_RUNTIME_ACCOUNT_SNAPSHOT_MAX_AGE_SECONDS=30
REGIME_RUNTIME_MAX_PROCESSING_LAG_SECONDS=75
REGIME_RUNTIME_MAX_DECISION_AGE_SECONDS=300

# Regime finalized one-minute publisher.
REGIME_PUBLISHER_FEED=iex
REGIME_PUBLISHER_FETCH_LIMIT=240
REGIME_PUBLISHER_WARMUP_BARS=120
REGIME_PUBLISHER_FINALIZATION_DELAY_SECONDS=5
REGIME_PUBLISHER_MAX_EVENT_AGE_SECONDS=300
REGIME_PUBLISHER_MATERIAL_GAP_MINUTES=2
REGIME_PUBLISHER_POLL_INTERVAL_SECONDS=1
REGIME_PUBLISHER_CLOSED_MARKET_POLL_INTERVAL_SECONDS=300

# App infrastructure.
DATABASE_URL=sqlite:///./data/trading.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local model integration.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
