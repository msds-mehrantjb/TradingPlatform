{
  "folders": [
    {
      "name": "TradingApp",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["backend/tests"],
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.pytest_tmp*": true,
      "**/pytest-cache-files-*": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/artifacts": true,
      "**/data": true,
      "**/*.log": true,
      "backend/.venv": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/backend/.venv/**": true,
      "**/data/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "backend: uvicorn (8020)",
        "type": "shell",
        "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn backend.app.main:app --reload --port 8020",
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": []
      },
      {
        "label": "backend: pytest",
        "type": "shell",
        "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest backend/tests",
        "options": { "cwd": "${workspaceFolder}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "frontend: dev server",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "problemMatcher": []
      },
      {
        "label": "frontend: typecheck",
        "type": "shell",
        "command": "npm run typecheck",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "build",
        "problemMatcher": ["$tsc"]
      }
    ]
  }
}
